# Frida, chytrá lednice. Zkopíruj jako .env (do kořene repa nebo do backend/).
# Bez jediné proměnné běží všechno v demo režimu. Každá sekce zapíná jednu integraci.
# Podrobný návod: docs/napojeni.md

# --- Obecné ------------------------------------------------------------------
# Veřejná HTTPS adresa backendu (Twilio na ni volá webhooky a otevírá WebSocket).
# Doma typicky přes Cloudflare Tunnel, viz docs/nasazeni.md.
FRIDA_PUBLIC_BASE_URL=http://localhost:8000
FRIDA_FRONTEND_ORIGIN=http://localhost:5173
# FRIDA_DATA_DIR=./data
FRIDA_TIMEZONE=Europe/Prague
# Prázdná databáze se naplní ukázkovou lednicí (jen s demo kamerou).
FRIDA_DEMO_SEED=true

# --- Domov (výchozí poloha, prohlížeč ji může přepsat) -------------------------
FRIDA_HOME_LAT=50.0755
FRIDA_HOME_LON=14.4378
FRIDA_HOME_LABEL="Praha 2 – Vinohrady"
FRIDA_SEARCH_RADIUS_M=2500
FRIDA_FAVORITE_CHAINS='["Albert","Lidl","Billa","Kaufland","Penny","Tesco","Globus"]'

# --- Claude (agent, rozpoznávání obrazu, recepty) --------------------------------
# Přímo Anthropic API (https://console.anthropic.com), žádné AWS.
ANTHROPIC_API_KEY=
FRIDA_AGENT_MODEL=claude-opus-5-5
FRIDA_AGENT_EFFORT_CHAT=medium
FRIDA_AGENT_EFFORT_VOICE=low
FRIDA_VISION_EFFORT=high
# Server-side fallback: když model požadavek odmítne, API ho samo zkusí na záložním modelu.
FRIDA_AGENT_FALLBACKS=true

# --- Kamery Reolink (Home Hub + Argus B310) -------------------------------------
FRIDA_REOLINK_HOST=
FRIDA_REOLINK_USERNAME=admin
FRIDA_REOLINK_PASSWORD=
FRIDA_REOLINK_USE_HTTPS=true
FRIDA_REOLINK_CHANNELS='[0,1]'
FRIDA_REOLINK_CAMERA_NAMES='["Police","Dveře"]'
FRIDA_DOOR_OPEN_ALERT_SECONDS=120
FRIDA_LIVE_VIEW_MAX_SECONDS=240
# go2rtc pro živý obraz (WebRTC). Adresa z pohledu backendu a z pohledu prohlížeče.
FRIDA_GO2RTC_URL=http://localhost:1984
FRIDA_GO2RTC_PUBLIC_URL=
# Pro go2rtc v Dockeru (infra/go2rtc.yaml):
REOLINK_HOST=
REOLINK_USER=admin
REOLINK_PASSWORD=

# --- Rozpoznávání obrazu ---------------------------------------------------------
# auto | claude | local | cascade | mock
# local/cascade = vision transformery doma (uv sync --extra vision-local), viz docs/integrace/lokalni-vision.md
FRIDA_VISION_PROVIDER=auto
FRIDA_LOCAL_VISION_DEVICE=auto
# čtení data z obalu lokálně, prázdné = vypnuto
FRIDA_LOCAL_VISION_OCR=florence-community/Florence-2-base
FRIDA_CASCADE_ESCALATE_BELOW=0.55

# --- Rohlík (MCP) ------------------------------------------------------------------
# Oficiální server (OAuth, doplň token) NEBO komunitní lokální server přes npx.
FRIDA_ROHLIK_MCP_URL=
FRIDA_ROHLIK_BEARER_TOKEN=
# FRIDA_ROHLIK_MCP_COMMAND="npx -y @tomaspavlin/rohlik-mcp"
FRIDA_ROHLIK_EMAIL=
FRIDA_ROHLIK_PASSWORD=

# --- Akce, obchody, čárové kódy ---------------------------------------------------------
FRIDA_DEALS_LIVE=false
# kupi.cz je vypnuté (robots.txt má pravidlo pro AI), zapnutí je na tobě: '["akcniceny","kupi"]'
FRIDA_DEALS_SOURCES='["akcniceny"]'
FRIDA_DEALS_CACHE_MINUTES=180
FRIDA_GEO_LIVE=false
FRIDA_BARCODE_LIVE=false
# Obecný User-Agent pro OpenStreetMap a Open Food Facts. Nevkládej sem osobní údaje.
FRIDA_HTTP_USER_AGENT="FridaSmartFridge/0.1 (+https://github.com/frida-smart-fridge)"
# true = bez demo podniků, jen odkazy do Woltu a foodory
FRIDA_DELIVERY_LIVE=false

# --- Telefon a zprávy (Twilio) ----------------------------------------------------------
FRIDA_TWILIO_ACCOUNT_SID=
FRIDA_TWILIO_AUTH_TOKEN=
FRIDA_TWILIO_FROM_NUMBER=
FRIDA_TWILIO_WHATSAPP_FROM=
FRIDA_USER_PHONE=
# Pojistka: volat jde jen na tato čísla (prázdné = jen FRIDA_USER_PHONE).
FRIDA_ALLOWED_CALL_NUMBERS='[]'
FRIDA_CALL_MAX_SECONDS=300
FRIDA_CALLS_PER_HOUR=3
FRIDA_CALLS_PER_DAY=8
FRIDA_QUIET_HOURS_START=22
FRIDA_QUIET_HOURS_END=7
FRIDA_CALL_WHEN_STAPLES_OUT=2
FRIDA_NOTIFY_SMS=false
FRIDA_NOTIFY_WHATSAPP=false
FRIDA_DIGEST_HOUR=8
FRIDA_VOICE_LANGUAGE=cs-CZ
FRIDA_VOICE_TTS_PROVIDER=ElevenLabs
FRIDA_VOICE_NAME=uYFJyGaibp4N2VwYQshk
FRIDA_VOICE_TRANSCRIPTION_PROVIDER=Deepgram
FRIDA_VOICE_SPEECH_MODEL=nova-3-general
FRIDA_VALIDATE_TWILIO_SIGNATURE=true

# --- Cloudflare Tunnel (veřejná HTTPS adresa bez otevírání portů) -------------------------
CLOUDFLARE_TUNNEL_TOKEN=
