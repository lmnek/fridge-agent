# Copy to bridge/.env. Only OPENAI_API_KEY is required, everything else has a fake mode.
OPENAI_API_KEY=
# REALTIME_MODEL=gpt-realtime-2.1
# REALTIME_VOICE=marin

# Rohlík MCP access token (OAuth). Empty = in-memory demo cart.
ROHLIK_TOKEN=
# ROHLIK_MCP_URL=https://mcp.rohlik.cz/mcp

# Reolink Home Hub on the LAN. Empty = the laptop webcam stands in.
REOLINK_HOST=
REOLINK_USER=admin
REOLINK_PASSWORD=
REOLINK_CHANNELS=0,1

# Vision for beat B (bridge/vision.py). Uses OPENAI_API_KEY.
# VISION_MODEL=gpt-5.5
# VISION_EFFORT=low

# Courier call for beat F (bridge/courier.py). Empty = only the fake call (POST /courier/fake).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
COURIER_NUMBER=
# The tunnel address that reaches the bridge, with /api when the tunnel points at the app on 5174.
PUBLIC_URL=
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# COURIER_MAX_SECONDS=90

# DEMO_SEED=1
